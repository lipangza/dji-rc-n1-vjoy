<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 简洁浅色风主题（无 ActionBar） -->
    <style name="Theme.Dji_vjoy" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg_light</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/bg_light</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>
</resources>
