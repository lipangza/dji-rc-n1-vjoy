# dji_vjoy USB 直连配置（改完重启 VJoy.exe 生效）
#
# inv  反向：0=不反向 1=反向
# ctr  中位：杆在物理中位时，输出落在行程的百分之几（50=正中）
#      穿越机油门用这个调悬停点：比如中位就想 45% 油门，就把第 2 个数改 45
# sens 灵敏度：杆滑动到目标要多久，100=最快(0.18 秒走完全行程)，10=最慢(1.68 秒)
#      这个不是延迟，是杆自己移动的速度，目标位置不变
#
# 顺序：左杆横(偏航) 左杆纵(油门) 右杆横(横滚) 右杆纵(俯仰)
inv=0,0,0,0
ctr=50,50,50,50
sens=100,100,100,100

# 中位死区（原始 SBUS 单位，3 很小，抖动大就加到 6~10）
deadzone=3
